---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import site from '../data/site.json';
---
<Base title="Contact" hero>
  <PageHead kicker="お問い合わせ" title="Contact" />
  <section class="contact">
    <div class="wrap grid">
      <div class="intro">
        <p>HIVE JAPANへのお問い合わせは、メールまたは下記のフォームからご連絡ください。</p>
        <p class="sub">活動へのご質問、協賛・取材のご相談など、お気軽にお寄せください。</p>
      </div>
      <div class="cards">
        <dl class="rows">
          <div>
            <dt>EMAIL</dt>
            <dd><a class="mail" href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>INSTAGRAM</dt>
            <dd><a href={site.instagram} target="_blank" rel="noopener">@hivejapan2025 ↗</a></dd>
          </div>
        </dl>
      </div>
    </div>
    {site.contactFormUrl && (
      <div class="wrap">
        <div class="form" id="form">
          <div class="form-head">
            <p class="kicker">Form</p>
            <p>フォームからもお問い合わせいただけます。</p>
          </div>
          <iframe
            src={`${site.contactFormUrl}?embedded=true`}
            title="HIVE JAPAN お問い合わせフォーム"
            loading="lazy"
          >読み込んでいます…</iframe>
          <p class="fallback">表示されない場合は<a href={site.contactFormUrl} target="_blank" rel="noopener">こちらからフォームを開いてください ↗</a></p>
        </div>
      </div>
    )}
  </section>
</Base>
<style>
  .contact { padding:96px 0 140px; }
  .grid { display:grid; grid-template-columns:5fr 7fr; gap:64px; align-items:start; }
  .intro p { margin:0 0 1em; font-size:1.06rem; line-height:2.1; }
  .intro .sub { color:var(--muted); font-size:.92rem; }
  .cards { display:flex; flex-direction:column; gap:28px; }
  .rows { margin:0; border-top:1px solid var(--line); }
  .rows > div { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px 24px; padding:24px 0; border-bottom:1px solid var(--line); }
  .rows dt { font-family:var(--font-en); font-size:var(--fs-label); font-weight:500; letter-spacing:var(--ls-label); color:var(--muted); }
  .rows dd { margin:0; }
  .rows a { font-family:var(--font-en); font-weight:500; font-size:var(--fs-card); color:var(--navy-900); text-decoration:none; word-break:break-all; }
  .rows a:hover { color:var(--navy-700); text-decoration:underline; text-underline-offset:4px; }
  .form { margin-top:72px; padding:40px; background:var(--card); border-radius:22px; box-shadow:0 20px 40px -32px rgba(10,26,58,.4); }
  .form-head p { margin:0 0 18px; }
  .form .kicker { margin-bottom:10px; }
  .form iframe { display:block; width:100%; max-width:720px; height:1180px; margin:8px auto 0; border:0; border-radius:12px; background:#fff; }
  .fallback { margin:16px 0 0; text-align:center; color:var(--muted); font-size:.85rem; }
  .fallback a { color:var(--navy-900); }
  .muted { color:var(--muted); font-size:.92rem; }
  .btn { display:inline-flex; align-items:center; gap:10px; padding:14px 28px; border-radius:999px; background:var(--navy-900); color:#fff; text-decoration:none; font-weight:700; letter-spacing:var(--ls-body); transition:background .3s, transform .3s var(--ease); }
  .btn span { color:var(--honey); }
  .btn:hover { background:var(--navy-700); transform:translateY(-2px); }
  @media (max-width:860px) { .grid { grid-template-columns:1fr; gap:36px; } .contact { padding:64px 0 100px; } .form { margin-top:48px; padding:20px 12px; } .form-head { padding:0 8px; } .form iframe { height:1320px; } }
</style>
