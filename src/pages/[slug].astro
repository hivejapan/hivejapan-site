---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title}>
  <h1>{page.data.title}</h1>
  {page.data.gallery[0] && <img class="cover" src={page.data.gallery[0]} alt="" />}
  <article class="prose"><Content /></article>
  {page.data.gallery.length > 1 && (
    <section class="gallery">
      <h2>Photos</h2>
      <div class="grid">{page.data.gallery.slice(1).map((src) => <a href={src}><img src={src} alt="" loading="lazy" /></a>)}</div>
    </section>
  )}
</Base>
<style>
  .cover { width:100%; max-height:420px; object-fit:cover; margin-bottom:28px; }
  .prose { max-width:760px; }
  .prose :global(p) { margin:0 0 1.1em; }
  .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  .grid img { width:100%; aspect-ratio:3/2; object-fit:cover; display:block; }
  @media (max-width:600px) { .grid { grid-template-columns:repeat(2,1fr); } }
</style>
