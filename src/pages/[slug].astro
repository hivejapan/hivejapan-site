---
import Base from '../layouts/Base.astro';
import Honeycomb from '../components/Honeycomb.astro';
import ProgramCard from '../components/ProgramCard.astro';
import SummitConcept from '../components/SummitConcept.astro';
import { getCollection, render } from 'astro:content';
import { getPrograms, KIND_LABEL } from '../lib/programs';
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const cover = d.thumb ?? d.photos[0];
const isReport = d.kind === 'report';
const all = await getPrograms();
// 同じ種類のほかの回 → 足りなければ他の種類で埋める
const others = [
  ...all.filter((p) => p.id !== page.id && p.kind === d.kind),
  ...all.filter((p) => p.id !== page.id && p.kind !== d.kind),
].slice(0, 3);
---
<Base title={d.title} hero>
  <header class="phero">
    {cover && <img class="cover" src={cover} alt="" transition:name={`cover-${page.id}`} />}
    <div class="shade"></div>
    <Honeycomb size={68} intensity={0.8} interval={2000} />
    <div class="wrap inner">
      <nav class="crumb" aria-label="パンくず"><a href="/">Home</a><span>/</span><a href="/#programs">{d.kind ? KIND_LABEL[d.kind] : 'Programs'}</a></nav>
      <h1>{d.title}</h1>
      {d.tagline && <p class="tagline">{d.tagline}</p>}
      {(d.date || d.place) && (
        <ul class="facts">
          {d.date && <li><span>DATE</span>{d.date}</li>}
          {d.place && <li><span>{isReport ? 'AUTHOR' : 'PLACE'}</span>{d.place}</li>}
        </ul>
      )}
    </div>
  </header>

  {d.concept && <SummitConcept />}

  {d.about && (
    <section class="sec about">
      <div class="wrap narrow">
        <p class="kicker">About</p>
        <h2 class="sec-title">{d.about.heading}</h2>
        {d.about.theme && (
          <div class="theme reveal">
            <p class="theme-label">テーマ</p>
            <p class="theme-text">{d.about.theme}</p>
          </div>
        )}
        <div class="text">{d.about.text.map((t) => <p>{t}</p>)}</div>

        {d.report && (
          <a class="report-card reveal" href={d.report.href}>
            <span class="rc-k">Event Report</span>
            <strong>{d.report.title}</strong>
            <span class="rc-lead">{d.report.lead}</span>
            <span class="rc-by">著者: {d.report.author}　—　レポートを読む →</span>
          </a>
        )}
      </div>
    </section>
  )}

  {isReport && (
    <div class="wrap body">
      <article class="prose"><Content /></article>
      {d.author && (
        <aside class="author">
          {d.author.photo && <img src={d.author.photo} alt={d.author.name} loading="lazy" />}
          <div>
            <p class="kicker">Author</p>
            <h3>{d.author.name}</h3>
            <p>{d.author.bio}</p>
            {d.author.links.length > 0 && <p class="links">{d.author.links.map((l) => <a href={l.url}>{l.label}</a>)}</p>}
          </div>
        </aside>
      )}
      {d.backTo && <p class="back"><a href={d.backTo.href}>← {d.backTo.label}</a></p>}
    </div>
  )}

  {d.guests.length > 0 && (
    <section class="sec guests">
      <div class="wrap">
        <p class="kicker">Special Guests</p>
        <h2 class="sec-title">スペシャルゲスト</h2>
        <div class="glist">
          {d.guests.map((g) => (
            <article class="guest reveal">
              {g.photo && <div class="gphoto"><img src={g.photo} alt={g.name} loading="lazy" /></div>}
              <div class="gbody">
                <h3>{g.name}</h3>
                {g.titles.length > 0 && <ul class="titles">{g.titles.map((t) => <li>{t}</li>)}</ul>}
                {g.bio.map((b) => <p>{b}</p>)}
              </div>
            </article>
          ))}
        </div>
        {d.panel && (
          <div class="panel reveal">
            <p class="theme-label">パネルディスカッションテーマ</p>
            <p class="theme-text">{d.panel}</p>
          </div>
        )}
      </div>
    </section>
  )}

  {(d.schedule || d.venue) && (
    <section class="sec info">
      <div class="wrap">
        <p class="kicker">Information</p>
        <h2 class="sec-title">開催概要</h2>
        <dl class="facts-table">
          {d.schedule && <><dt>合宿日程</dt><dd>{d.schedule}</dd></>}
          {d.venue && (
            <>
              <dt>会場</dt>
              <dd>
                <strong>{d.venue.name}</strong>
                {d.venue.address && <span class="addr">{d.venue.address}</span>}
                {d.venue.url && <a class="ext" href={d.venue.url} target="_blank" rel="noopener">公式サイト ↗</a>}
              </dd>
            </>
          )}
        </dl>
        {d.venue && d.venue.photos.length > 0 && (
          <div class="venue-photos" aria-label="会場の写真">
            {d.venue.photos.map((src) => <img src={src} alt="" loading="lazy" />)}
          </div>
        )}
      </div>
    </section>
  )}

  {d.press.length > 0 && (
    <section class="sec press">
      <div class="wrap">
        <p class="kicker">Media</p>
        <h2 class="sec-title">合宿を終えて ── メディア掲載</h2>
        {d.press.map((p) => (
          <a class="press-card reveal" href={p.url} target="_blank" rel="noopener">
            <img src={p.image} alt="" loading="lazy" />
            <span>{p.label}<em>記事を読む ↗</em></span>
          </a>
        ))}
      </div>
    </section>
  )}

  {d.photos.length > 0 && (
    <section class="photos">
      <div class="wrap">
        <p class="kicker">Photos</p>
        <h2 class="sec-title">当日の様子</h2>
        <div class="grid">
          {d.photos.map((src, i) => (
            <button class="ph reveal" type="button" data-i={i} style={`transition-delay:${(i % 6) * 60}ms`} aria-label={`写真 ${i + 1} を拡大`}>
              <img src={src} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
      <dialog class="lightbox" data-srcs={JSON.stringify(d.photos)}>
        <img alt="" />
        <button class="lb-close" type="button" aria-label="閉じる">×</button>
        <button class="lb-prev" type="button" aria-label="前の写真">‹</button>
        <button class="lb-next" type="button" aria-label="次の写真">›</button>
      </dialog>
    </section>
  )}

  {others.length > 0 && (
    <section class="more">
      <div class="wrap">
        <p class="kicker">More</p>
        <h2 class="sec-title">ほかの開催も見る</h2>
        <div class="cards">{others.map((p) => <ProgramCard p={p} />)}</div>
        <a class="all" href="/#programs">すべての開催一覧へ →</a>
      </div>
    </section>
  )}
</Base>

<script>
  function setupLightbox() {
    const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (!dlg || dlg.dataset.ready) return;
    dlg.dataset.ready = '1';
    const srcs: string[] = JSON.parse(dlg.dataset.srcs || '[]');
    const img = dlg.querySelector('img')!;
    let i = 0;
    const show = (n: number) => { i = (n + srcs.length) % srcs.length; img.src = srcs[i]; };
    document.querySelectorAll<HTMLButtonElement>('.photos .ph').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.i)); dlg.showModal(); }));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(i - 1); if (e.key === 'ArrowRight') show(i + 1); });
  }
  document.addEventListener('astro:page-load', setupLightbox);
</script>

<style>
  /* ---- hero ---- */
  .phero { position:relative; min-height:min(78svh,760px); display:flex; align-items:flex-end; background:var(--navy-950); color:#fff; overflow:hidden; }
  .cover { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .shade { position:absolute; inset:0; background:
      linear-gradient(90deg, rgba(5,13,32,.85) 0%, rgba(5,13,32,.45) 70%, rgba(5,13,32,.3) 100%),
      linear-gradient(180deg, rgba(10,26,58,.5) 0%, rgba(10,26,58,.3) 40%, rgba(5,13,32,.97) 100%); }
  .inner { position:relative; width:100%; padding-top:140px; padding-bottom:64px; }
  .crumb { display:flex; gap:10px; font-family:var(--font-en); font-size:.72rem; letter-spacing:.2em; text-transform:uppercase; color:var(--honey-soft); margin-bottom:18px; }
  .crumb a { text-decoration:none; opacity:.85; }
  .crumb a:hover { opacity:1; }
  .crumb span { opacity:.5; }
  h1 { margin:0; font-family:var(--font-en); font-weight:800; font-size:clamp(2rem,6vw,4.4rem); line-height:1.15; letter-spacing:.02em; max-width:15em; animation:rise .9s .25s var(--ease) both; }
  .tagline { margin:18px 0 0; font-family:var(--font-mincho); font-weight:800; font-size:clamp(1.1rem,2.6vw,1.7rem); letter-spacing:.1em; color:var(--honey-soft); animation:rise .9s .4s var(--ease) both; max-width:30em; }
  .facts { list-style:none; margin:28px 0 0; padding:0; display:flex; flex-wrap:wrap; gap:10px; animation:rise .9s .55s var(--ease) both; }
  .facts li { padding:8px 16px; border:1px solid rgba(255,255,255,.22); border-radius:999px; font-size:.86rem; background:rgba(5,13,32,.35); backdrop-filter:blur(6px); }
  .facts span { font-family:var(--font-en); font-size:.64rem; letter-spacing:.2em; color:var(--honey); margin-right:10px; }
  @keyframes rise { from { opacity:0; transform:translateY(24px); } }

  /* ---- sections ---- */
  .sec { padding:100px 0; }
  .sec + .sec:not(.info):not(.press) { padding-top:0; }
  .narrow { max-width:820px; }

  /* about / theme */
  .theme, .panel { margin:0 0 36px; padding:28px 32px; background:var(--card); border-radius:18px; border-left:4px solid var(--honey); box-shadow:0 20px 40px -32px rgba(10,26,58,.4); }
  .theme-label { margin:0 0 6px; font-size:.78rem; font-weight:700; letter-spacing:.2em; color:var(--muted); }
  .theme-text { margin:0; font-family:var(--font-mincho); font-weight:800; font-size:clamp(1.4rem,3.4vw,2.2rem); line-height:1.5; letter-spacing:.06em; color:var(--navy-900); }
  .text p { margin:0 0 1.2em; font-size:1.04rem; }
  .report-card { display:grid; gap:8px; margin-top:44px; padding:28px 32px; border-radius:18px; text-decoration:none; color:var(--on-navy); background:var(--navy-900); transition:transform .4s var(--ease), box-shadow .4s; }
  .report-card:hover { transform:translateY(-4px); box-shadow:0 24px 40px -20px rgba(10,26,58,.6); }
  .rc-k { font-family:var(--font-en); font-size:.7rem; letter-spacing:.24em; text-transform:uppercase; color:var(--honey); }
  .report-card strong { font-size:1.15rem; color:#fff; }
  .rc-lead { font-size:.9rem; color:var(--on-navy-muted); }
  .rc-by { font-size:.85rem; color:var(--honey-soft); }

  /* guests */
  .guests { background:var(--paper); }
  .glist { display:grid; gap:24px; }
  .guest { display:grid; grid-template-columns:160px 1fr; gap:36px; align-items:start; background:var(--card); border-radius:22px; padding:32px; box-shadow:0 20px 40px -32px rgba(10,26,58,.35); }
  .gphoto { aspect-ratio:1 / 1.1547; clip-path:var(--hex); overflow:hidden; background:var(--navy-700); }
  .gphoto img { width:100%; height:100%; object-fit:cover; object-position:center 25%; display:block; }
  .gbody h3 { margin:0 0 8px; font-size:1.3rem; color:var(--navy-900); }
  .titles { list-style:none; margin:0 0 14px; padding:0; display:grid; gap:2px; }
  .titles li { position:relative; padding-left:16px; font-size:.86rem; font-weight:700; color:var(--navy-700); line-height:1.7; }
  .titles li::before { content:""; position:absolute; left:0; top:.6em; width:7px; height:8px; background:var(--honey); clip-path:var(--hex); }
  .gbody p { margin:0 0 .8em; font-size:.92rem; line-height:1.95; }
  .panel { margin-top:32px; }
  @media (max-width:700px) {
    .guest { grid-template-columns:1fr; gap:18px; padding:24px; }
    .gphoto { width:130px; }
  }

  /* info */
  .info { background:var(--navy-900); color:var(--on-navy); }
  .info .sec-title { color:#fff; }
  .facts-table { display:grid; grid-template-columns:140px 1fr; margin:0; border-top:1px solid rgba(255,255,255,.12); }
  .facts-table dt, .facts-table dd { margin:0; padding:22px 0; border-bottom:1px solid rgba(255,255,255,.12); }
  .facts-table dt { font-size:.82rem; font-weight:700; letter-spacing:.14em; color:var(--honey); }
  .facts-table dd { display:flex; flex-direction:column; gap:4px; font-size:1.05rem; }
  .facts-table strong { color:#fff; font-size:1.15rem; }
  .addr { color:var(--on-navy-muted); font-size:.9rem; }
  .ext { color:var(--honey-soft); font-size:.88rem; width:max-content; }
  @media (max-width:600px) { .facts-table { grid-template-columns:1fr; } .facts-table dt { padding-bottom:0; border-bottom:none; } }
  .venue-photos { display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; margin-top:36px; padding-bottom:10px; scrollbar-width:thin; }
  .venue-photos img { flex:0 0 auto; width:min(360px,78vw); aspect-ratio:3/2; object-fit:cover; border-radius:12px; scroll-snap-align:start; }

  /* press */
  .press-card { display:grid; grid-template-columns:minmax(0,420px) 1fr; gap:28px; align-items:center; text-decoration:none; color:var(--ink); background:var(--card); border-radius:18px; overflow:hidden; box-shadow:0 20px 40px -32px rgba(10,26,58,.4); transition:transform .4s var(--ease); }
  .press-card:hover { transform:translateY(-4px); }
  .press-card img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
  .press-card span { padding:20px 28px 20px 0; font-weight:700; line-height:1.7; }
  .press-card em { display:block; margin-top:8px; font-style:normal; font-weight:400; font-size:.86rem; color:var(--navy-700); }
  @media (max-width:700px) { .press-card { grid-template-columns:1fr; gap:0; } .press-card span { padding:18px 20px; } }

  /* report body */
  .body { padding-top:88px; padding-bottom:64px; }
  .prose { max-width:740px; margin:0 auto; font-size:1.02rem; }
  .prose :global(p) { margin:0 0 1.3em; }
  .prose :global(h2) { position:relative; margin:2.6em 0 .8em; padding-left:26px; font-size:1.35rem; line-height:1.6; color:var(--navy-900); }
  .prose :global(h2::before) { content:""; position:absolute; left:0; top:.42em; width:13px; height:15px; background:var(--honey); clip-path:var(--hex); }
  .prose :global(ol) { margin:0 0 1.6em; padding:22px 26px 22px 2.6em; background:var(--card); border-radius:14px; box-shadow:0 16px 32px -28px rgba(10,26,58,.4); }
  .prose :global(ol li) { margin:.3em 0; font-weight:700; color:var(--navy-900); }
  .prose :global(ol li::marker) { color:var(--honey); font-family:var(--font-en); font-weight:800; }
  .prose :global(figure) { margin:2.2em 0; }
  .prose :global(figure img) { width:100%; border-radius:14px; display:block; }
  .prose :global(figcaption) { margin-top:8px; font-size:.8rem; color:var(--muted); }
  .prose :global(.refs ul) { padding-left:1.2em; font-size:.82rem; color:var(--muted); line-height:1.8; }
  .prose :global(.refs li) { margin-bottom:.5em; }
  .author { max-width:740px; margin:64px auto 0; display:grid; grid-template-columns:120px 1fr; gap:28px; padding:28px; background:var(--card); border-radius:18px; box-shadow:0 20px 40px -32px rgba(10,26,58,.35); }
  .author img { width:120px; aspect-ratio:1 / 1.1547; object-fit:cover; clip-path:var(--hex); }
  .author h3 { margin:0 0 8px; color:var(--navy-900); }
  .author p { margin:0; font-size:.9rem; }
  .author .kicker { margin-bottom:6px; }
  .author .links { margin-top:10px; display:flex; gap:16px; }
  .author .links a { color:var(--navy-700); }
  @media (max-width:600px) { .author { grid-template-columns:1fr; } }
  .back { max-width:740px; margin:40px auto 0; }
  .back a { color:var(--navy-700); font-weight:700; text-decoration:none; }

  /* photos */
  .photos { padding:100px 0; }
  .grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
  .ph { all:unset; cursor:zoom-in; display:block; aspect-ratio:1; overflow:hidden; border-radius:12px; background:var(--navy-800); }
  .ph:nth-child(7n+1) { grid-column:span 2; grid-row:span 2; }
  .ph:focus-visible { outline:3px solid var(--honey); outline-offset:2px; }
  .ph img { width:100%; height:100%; object-fit:cover; display:block; transition:transform 1s var(--ease); }
  .ph:hover img { transform:scale(1.05); }
  @media (max-width:700px) { .grid { grid-template-columns:repeat(2,1fr); } }

  .lightbox { border:none; padding:0; background:transparent; max-width:100vw; max-height:100vh; width:100vw; height:100vh; }
  .lightbox::backdrop { background:rgba(5,13,32,.92); backdrop-filter:blur(6px); }
  .lightbox[open] { display:grid; place-items:center; animation:fadein .3s; }
  .lightbox img { max-width:92vw; max-height:86vh; border-radius:8px; object-fit:contain; }
  .lightbox button { position:fixed; width:52px; height:60px; clip-path:var(--hex); border:none; background:rgba(255,255,255,.12); color:#fff; font-size:1.8rem; cursor:pointer; transition:background .2s; }
  .lightbox button:hover { background:var(--honey); color:var(--navy-950); }
  .lb-close { top:20px; right:20px; }
  .lb-prev { left:20px; top:50%; translate:0 -50%; }
  .lb-next { right:20px; top:50%; translate:0 -50%; }
  @keyframes fadein { from { opacity:0; } }

  .more { background:var(--navy-900); color:var(--on-navy); padding:100px 0 110px; }
  .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  @media (max-width:900px) { .cards { grid-template-columns:1fr; } }
  .all { display:inline-block; margin-top:36px; color:var(--honey); text-decoration:none; font-weight:700; letter-spacing:.06em; }
  .all:hover { text-decoration:underline; text-underline-offset:4px; }
</style>
