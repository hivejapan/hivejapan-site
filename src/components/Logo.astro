---
// 正式ロゴ（HIVE JAPAN 2026 投影資料より）。文字は currentColor、六角形はゴールド
import svg from '../assets/hive-logo.svg?raw';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} set:html={svg} />
<style>
  .logo { display:inline-flex; align-items:center; line-height:0; color:#fff; }
  .logo :global(svg) { height:52px; width:auto; display:block; }
  @media (max-width:600px) { .logo :global(svg) { height:44px; } }
</style>
