---
import { ClientRouter } from 'astro:transitions';
import site from '../data/site.json';
import Logo from '../components/Logo.astro';
import { pageFade } from '../lib/transitions';
interface Props { title?: string; description?: string; hero?: boolean }
const { title, description = '「日本の未来を切り拓く」— 志ある若者が領域を超えて集うコミュニティ HIVE JAPAN', hero = false } = Astro.props;
const fullTitle = title ? `${title} | HIVE JAPAN` : 'HIVE JAPAN';
---
<!doctype html>
<html lang="ja" transition:animate={pageFade}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a1a3a" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;500;700&display=swap" rel="stylesheet" />
  <ClientRouter />
  <style is:global>
    :root {
      --navy-950:#050d20; --navy-900:#0a1a3a; --navy-800:#11264f; --navy-700:#1b3768; --navy-500:#3d5a92;
      --honey:#e9b44c; --honey-soft:#f3d48e;
      --paper:#f5f6f9; --card:#ffffff; --ink:#0d1b36; --muted:#5a6680; --line:rgba(13,27,54,.12);
      --on-navy:#e8edf7; --on-navy-muted:#9fb0d0;
      --font-jp:"Noto Sans JP","Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic",Meiryo,system-ui,sans-serif;
      --font-mincho:var(--font-jp); /* 旧サイト hivejapan.org に合わせ Noto Sans JP に統一 */
      --font-en:var(--font-jp);
      /* 文字サイズは4段階：ページタイトル／セクション／カード・小見出し／本文(1rem) */
      --fs-title:clamp(2.6rem,8vw,6rem); --fs-section:clamp(1.7rem,3.6vw,2.6rem); --fs-card:clamp(1.1rem,2.2vw,1.4rem); --fs-label:.72rem;
      /* 字間は3段階：本文／見出し／英字ラベル */
      --ls-body:.02em; --ls-head:.04em; --ls-label:.2em;
      --hex: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
      --ease: cubic-bezier(.2,.8,.2,1);
      color-scheme: light;
    }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    /* body は紺（ページ遷移中に背後に見える色）、本文エリアは main が紙色 */
    body { margin:0; background:var(--navy-950); color:var(--ink); font-family:var(--font-jp); font-weight:300; line-height:1.95; letter-spacing:var(--ls-body); -webkit-font-smoothing:antialiased; }
    a { color:inherit; }
    :focus-visible { outline:3px solid var(--honey); outline-offset:3px; border-radius:4px; }
    .skip { position:absolute; left:12px; top:-60px; z-index:100; padding:10px 16px; background:var(--honey); color:var(--navy-950); font-weight:700; border-radius:8px; text-decoration:none; }
    .skip:focus { top:12px; }
    img { max-width:100%; height:auto; }
    .wrap { max-width:1120px; margin:0 auto; padding:0 24px; }
    @media (max-width:600px) { .wrap { padding:0 16px; } }
    .kicker { font-family:var(--font-en); font-size:var(--fs-label); font-weight:500; letter-spacing:var(--ls-label); text-transform:uppercase; color:inherit; opacity:.72; display:inline-flex; align-items:center; gap:10px; margin:0 0 14px; }
    .kicker::before { content:""; width:24px; height:1px; background:var(--honey); }
    .sec-title { font-family:var(--font-mincho); font-weight:500; font-size:var(--fs-section); line-height:1.4; margin:0 0 28px; letter-spacing:var(--ls-head); }

    /* ---------- header ---------- */
    /* 背景のぼかしは ::before に置く。header 自体に backdrop-filter を付けると、
       スマホのメニュー（position:fixed）がヘッダーの高さに閉じ込められて一部しか表示されない */
    header.site { position:fixed; inset:0 0 auto; z-index:50; color:var(--on-navy); transition:box-shadow .4s var(--ease); box-shadow:0 1px 0 rgba(255,255,255,.06); }
    header.site::before { content:""; position:absolute; inset:0; z-index:-1; background:rgba(10,26,58,.82); backdrop-filter:blur(14px) saturate(1.4); -webkit-backdrop-filter:blur(14px) saturate(1.4); transition:opacity .4s var(--ease); }
    html.on-hero:not(.scrolled) header.site { box-shadow:none; }
    html.on-hero:not(.scrolled) header.site::before { opacity:0; }
    header.site .wrap { display:flex; align-items:center; justify-content:space-between; gap:16px; height:68px; }
    .home-link { text-decoration:none; position:relative; z-index:2; top:4px; } /* ロゴ文字の中心をメニュー文字の中心に合わせる */
    nav.main > ul { list-style:none; margin:0; padding:0; display:flex; align-items:center; gap:4px; font-size:.88rem; }
    nav.main li { position:relative; }
    nav.main a, nav.main summary { display:block; padding:8px 14px; text-decoration:none; color:var(--on-navy); opacity:.86; border-radius:999px; cursor:pointer; transition:opacity .2s, background .2s; list-style:none; }
    nav.main summary::-webkit-details-marker { display:none; }
    nav.main summary::after { content:""; display:inline-block; width:6px; height:6px; margin-left:8px; border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor; transform:translateY(-3px) rotate(45deg); transition:transform .25s; }
    nav.main details[open] summary::after { transform:translateY(0) rotate(-135deg); }
    nav.main summary a { display:inline; padding:0; border:none; border-radius:0; background:none; opacity:1; }
    nav.main summary a:hover { background:none; }
    nav.main a:hover, nav.main summary:hover, nav.main details[open] summary { opacity:1; background:rgba(255,255,255,.08); }
    nav.main .sub { list-style:none; margin:0; padding:8px; position:absolute; top:calc(100% + 10px); left:0; min-width:220px; background:var(--navy-900); border:1px solid rgba(255,255,255,.1); border-radius:14px; box-shadow:0 20px 40px -12px rgba(0,0,0,.5); animation:drop .25s var(--ease); }
    nav.main .sub a { border-radius:8px; padding:9px 14px; }
    @keyframes drop { from { opacity:0; transform:translateY(-6px); } }
    .menu-toggle { position:absolute; opacity:0; pointer-events:none; }
    .menu-btn { display:none; }
    @media (max-width:860px) {
      .menu-btn { display:grid; place-items:center; width:44px; height:44px; cursor:pointer; position:relative; z-index:2; }
      .menu-btn span, .menu-btn span::before { display:block; width:22px; height:2px; background:currentColor; border-radius:2px; transition:transform .35s var(--ease); position:relative; }
      .menu-btn span { transform:translateY(-4px); }
      .menu-btn span::before { content:""; position:absolute; top:8px; }
      .menu-toggle:checked ~ .menu-btn span { transform:translateY(0) rotate(45deg); }
      .menu-toggle:checked ~ .menu-btn span::before { transform:translateY(-8px) rotate(-90deg); }
      nav.main { position:fixed; inset:0; background:var(--navy-950); padding:96px 24px 40px; overflow-y:auto; clip-path:circle(0 at calc(100% - 38px) 34px); transition:clip-path .6s var(--ease); visibility:hidden; }
      .menu-toggle:checked ~ nav.main { clip-path:circle(150% at calc(100% - 38px) 34px); visibility:visible; }
      html:has(.menu-toggle:checked) { overflow:hidden; }
      nav.main > ul { flex-direction:column; align-items:stretch; gap:6px; font-size:1.15rem; }
      nav.main a, nav.main summary { padding:12px 6px; border-radius:0; border-bottom:1px solid rgba(255,255,255,.08); }
      nav.main .sub { position:static; background:none; border:none; box-shadow:none; padding:4px 0 8px 18px; animation:none; }
      nav.main .sub a { font-size:1rem; border:none; padding:8px 6px; }
    }

    /* ---------- main ---------- */
    main { display:block; min-height:60vh; background:var(--paper); }
    .page-pad { padding-top:68px; }

    /* ---------- footer ---------- */
    footer.site { position:relative; background:var(--navy-950); color:var(--on-navy-muted); overflow:hidden; font-size:.86rem; }
    footer.site .wrap { position:relative; padding-top:72px; padding-bottom:40px; display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:40px; }
    footer.site .brand { color:var(--on-navy); text-decoration:none; }
    footer.site p { margin:14px 0 0; }
    footer.site ul { list-style:none; margin:0; padding:0; }
    footer.site li a { text-decoration:none; display:inline-block; padding:3px 0; }
    footer.site a:hover { color:var(--on-navy); }
    footer.site .copy { grid-column:1 / -1; border-top:1px solid rgba(255,255,255,.08); padding-top:22px; font-size:.76rem; letter-spacing:var(--ls-body); }
    @media (max-width:760px) { footer.site .wrap { grid-template-columns:1fr; gap:28px; } }

    /* ---------- page transitions ---------- */
    @keyframes hive-page-out { to { opacity:0; } }
    @keyframes hive-fade-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
    /* サムネイル →カバー写真のモーフィング */
    ::view-transition-group(*) { animation-duration:.7s; animation-timing-function:cubic-bezier(.7,0,.2,1); }
    /* 古いページが沈んだあとに見える紺の背景 */
    html::view-transition { background:var(--navy-950); }

    /* reveal on scroll */
    .reveal { opacity:0; transform:translateY(24px); transition:opacity .9s var(--ease), transform .9s var(--ease); }
    .reveal.in { opacity:1; transform:none; }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior:auto; }
      .reveal { opacity:1; transform:none; transition:none; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#content">本文へスキップ</a>
  <header class="site" transition:persist="site-header" transition:name="site-header" transition:animate="none">
    <div class="wrap">
      <a class="home-link" href="/" aria-label="HIVE JAPANトップ"><Logo /></a>
      <input type="checkbox" id="menu" class="menu-toggle" />
      <label for="menu" class="menu-btn" aria-label="メニュー"><span></span></label>
      <nav class="main" aria-label="メイン">
        <ul>
          {site.nav.map((n) => n.children ? (
            <li><details><summary><a href={n.href}>{n.label}</a></summary><ul class="sub">{n.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul></details></li>
          ) : (<li><a href={n.href}>{n.label}</a></li>))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="content" class={hero ? '' : 'page-pad'} data-hero={hero ? '1' : undefined}>
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <div>
        <a class="brand" href="/"><Logo /></a>
      </div>
      <div>
        <ul>
          <li><a href="/about/">About</a></li>
          {site.nav.filter((n) => n.children).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/report-2026/">Report</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <ul>
          <li>運営団体 HIVE JAPAN 運営委員会</li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.instagram}>Instagram</a></li>
        </ul>
      </div>
      <p class="copy">© HIVE JAPAN {new Date().getFullYear()} All rights reserved.</p>
    </div>
  </footer>

  <script>
    // ヘッダー状態・メニュー・スクロール表示（ページ遷移のたびに実行）
    let io: IntersectionObserver | undefined;
    function setup() {
      const root = document.documentElement;
      const onHero = !!document.querySelector('main[data-hero]');
      root.classList.toggle('on-hero', onHero);
      const toggle = document.getElementById('menu') as HTMLInputElement | null;
      if (toggle) toggle.checked = false;
      document.querySelectorAll('nav.main details').forEach((d) => d.removeAttribute('open'));
      const onScroll = () => root.classList.toggle('scrolled', scrollY > 40);
      onScroll();
      window.removeEventListener('scroll', (window as any).__hiveScroll);
      (window as any).__hiveScroll = onScroll;
      window.addEventListener('scroll', onScroll, { passive: true });
      io?.disconnect();
      io = new IntersectionObserver((ents) => ents.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io!.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io!.observe(el));
    }
    document.addEventListener('astro:page-load', setup);
    // サムネイル →カバー写真のモーフィング：クリックしたカードの写真だけに名前を付ける
    document.addEventListener('astro:before-preparation', (e: any) => {
      const img = e.sourceElement?.closest?.('a.pcard')?.querySelector('img[data-vt]') as HTMLElement | null;
      if (img) img.style.viewTransitionName = img.dataset.vt!;
    });
    // 戻るとき：遷移先ページで、元のページのカードに名前を付けてカバー写真をカードへ戻す
    document.addEventListener('astro:before-swap', (e: any) => {
      if (e.direction !== 'back') return;
      const img = e.newDocument.querySelector(`a.pcard[href="${e.from.pathname}"] img[data-vt]`) as HTMLElement | null;
      if (img) img.style.viewTransitionName = img.dataset.vt!;
    });
    // ドロップダウン: 1つだけ開く／外側クリックで閉じる
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      document.querySelectorAll('nav.main details[open]').forEach((d) => { if (!d.contains(t)) d.removeAttribute('open'); });
    });
  </script>
</body>
</html>
